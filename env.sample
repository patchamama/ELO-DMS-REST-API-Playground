# Copy this file to ".env" (in this same folder) and adjust. All values optional.

ELOPG_HOST=127.0.0.1
ELOPG_PORT=8010

# Default ELO connection (pre-fills the connection form). If these are unset,
# connect() falls back to exactly these values (a stock local ELO test box).
ELOPG_ELO_BASE_URL=http://localhost:9090/ix-Repository1
ELOPG_ELO_USER=Administrator
ELOPG_ELO_PASSWORD=elo
ELOPG_TLS_VERIFY=true

# Runner
ELOPG_MOCK=true
ELOPG_NODE_URL=http://127.0.0.1:8787
ELOPG_RUN_TIMEOUT_S=15
